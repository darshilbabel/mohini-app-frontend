{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"],
    "baseUrl": "src",
    "paths": {
      // "@pages/*": ["tests/pages/*"],
      // "@helpers/*": ["tests/helpers/*"],
      // "@fixtures/*": ["tests/fixtures/*"],
      // "@config/*": ["tests/config/*"],
      // "@src/config/*": ["config/*"]
    }
  },
  "include": ["tests/**/*", "playwright.config.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}